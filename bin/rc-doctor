#!/bin/zsh
# rc-doctor: check that the installed setup matches the repo and is running.
# Read-only. Exits non-zero if any check fails.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
repo="${0:A:h:h}"
[[ -f "$HOME/.config/rc-loop.env" ]] && source "$HOME/.config/rc-loop.env"
fail=0
pass() { echo "ok    $*"; }
bad()  { echo "FAIL  $*"; fail=1; }
note() { echo "note  $*"; }
for src in "$repo"/bin/*; do
  t="$HOME/.local/bin/${src:t}"
  if [[ -L "$t" && "${t:A}" == "${src:A}" ]]; then pass "${src:t} links into the clone"
  else bad "${src:t} is not a link into $repo (run install.sh)"; fi
done
if [[ -z "$(git -C "$repo" status --porcelain)" ]]; then pass "clone has no local edits"
else bad "clone has local edits; commit them upstream instead of editing on this machine"; fi
git -C "$repo" fetch -q origin 2>/dev/null
if [[ "$(git -C "$repo" rev-parse HEAD)" == "$(git -C "$repo" rev-parse origin/main 2>/dev/null)" ]]; then pass "clone is at origin/main"
else bad "clone isn't at origin/main (on $(git -C "$repo" branch --show-current); git switch main && git pull)"; fi
[[ -f "$HOME/.config/rc-loop.env" ]] && pass "~/.config/rc-loop.env exists" || bad "~/.config/rc-loop.env missing"
if pgrep -f "rc-loop" >/dev/null; then pass "rc-loop is running"
elif pgrep -f "claude remote-control" >/dev/null; then bad "a remote-control server is running, but not under rc-loop (pre-migration script?)"
else bad "no remote-control server is running"; fi
tmux has-session -t rc 2>/dev/null && pass "tmux session rc exists" || bad "no tmux session named rc"
[[ "$(pmset -g 2>/dev/null | awk '$1=="sleep"{print $2}')" == 0 ]] && pass "system sleep is off" || bad "system sleep is on; Remote Control can't serve sessions while the Mac sleeps"
if [[ "${RC_CHROME:-}" == 1 ]]; then
  # Chrome/Brave keep it two levels down (Google/Chrome), Edge one (Microsoft Edge).
  as="$HOME/Library/Application Support" f=NativeMessagingHosts/com.anthropic.claude_code_browser_extension.json
  hosts=( "$as"/*/$f(N) "$as"/*/*/$f(N) )
  # claude --chrome writes these for browsers that aren't installed too, so this only proves setup ran.
  (( ${#hosts} )) && pass "Claude in Chrome connection file exists (${#hosts} folder(s); /chrome shows whether it's connected)" \
    || bad "RC_CHROME=1 but no Claude in Chrome connection file; run claude --chrome once on the Mac's screen"
  running=""
  for b in "Google Chrome" "Microsoft Edge" "Brave Browser" "Arc" "Vivaldi" "Opera"; do
    pgrep -xq "$b" && { running="$b"; break; }
  done
  [[ -n "$running" ]] && pass "$running is running" || bad "RC_CHROME=1 but no supported browser is running; Claude Code doesn't start it"
fi
# Ollama is optional, so its absence is a note, not a failure.
curl -sf http://localhost:11434/api/tags >/dev/null && pass "Ollama answers on :11434" || note "Ollama isn't answering on :11434 (only matters if you use ask-local)"
exit $fail

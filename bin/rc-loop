#!/bin/zsh
# rc-loop: keep a Claude Code Remote Control server running; restart it if it exits.
# usage: rc-loop [repo-dir] [session-name]
# Defaults come from ~/.config/rc-loop.env (see config/rc-loop.env.example).
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
[[ -f "$HOME/.config/rc-loop.env" ]] && source "$HOME/.config/rc-loop.env"
repo="${1:-${RC_REPO:-}}"
name="${2:-${RC_NAME:-}}"
spawn="${RC_SPAWN:-worktree}"
delay="${RC_RESTART_DELAY:-30}"
chrome="${RC_CHROME:-}"
if [[ -z "$repo" ]]; then
  echo 'usage: rc-loop [repo-dir] [session-name]   (or set RC_REPO in ~/.config/rc-loop.env)' >&2; exit 2
fi
cd "$repo" || { echo "rc-loop: repo not found: $repo" >&2; exit 1; }
# Passing --spawn means a restart never stops at the interactive spawn-mode question.
args=(remote-control --spawn="$spawn")
[[ -n "$name" ]] && args+=(--name "$name")
# Sessions the server starts have Chrome off unless the server gets --chrome.
case "$chrome" in
  1) args+=(--chrome) ;;
  0) args+=(--no-chrome) ;;
  '') ;;
  *) echo "rc-loop: ignoring RC_CHROME=$chrome (use 1, 0 or leave empty)" >&2 ;;
esac
# Refuse to start with a missing, broken or old claude (e.g. a stale npm install earlier in
# PATH): it would fail on rc-loop's flags and restart forever. 2.1.273 added --chrome.
command -v claude >/dev/null || { echo "rc-loop: claude isn't on PATH" >&2; exit 1; }
ver=$(claude --version 2>/dev/null | awk 'NR==1{print $1}')
autoload -Uz is-at-least
if [[ -z "$ver" ]] || ! is-at-least 2.1.273 "$ver"; then
  echo "rc-loop: $(command -v claude) is ${ver:-unusable}; need 2.1.273 or later (run rc-doctor)" >&2; exit 1
fi
echo "rc-loop: claude $ver at $(command -v claude)"
# A debug log per server start, so a restart doesn't overwrite the log of the run that went wrong.
# RC_DEBUG_DIR="" turns it off. Claude Code adds a log and a transcript (.jsonl) per session there.
# Files not written to for 14 days are deleted at each start.
logdir="${RC_DEBUG_DIR-$HOME/Library/Logs/rc-loop}"
[[ -n "$logdir" ]] && { mkdir -p "$logdir" || { echo "rc-loop: can't create $logdir; no debug log" >&2; logdir=""; }; }
while true; do
  run_args=("${args[@]}")
  if [[ -n "$logdir" ]]; then
    find "$logdir/" -maxdepth 1 -type f \( -name 'remote-control-*.log' -o -name 'bridge-transcript-*.jsonl' \) -mtime +14 -delete
    log="$logdir/remote-control-$(date '+%Y%m%d-%H%M%S').log"
    run_args+=(--debug-file "$log")
    echo "rc-loop: debug log $log"
  fi
  claude "${run_args[@]}"
  code=$?
  echo "$(date '+%a %H:%M') remote-control exited ($code). Restarting in ${delay}s; press Ctrl+C to stop."
  sleep "$delay"
done

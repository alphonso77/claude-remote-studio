# Copy to ~/.config/ollama-tunnel.env and edit. ollama-tunnel and rc-doctor source it.
# Only needed if a hosted app (not this Mac) calls the local model.
OLLAMA_TUNNEL_URL="https://your-name.ngrok-free.dev"   # your reserved ngrok domain
OLLAMA_TUNNEL_PORT=11434                               # where Ollama listens locally
# OLLAMA_TUNNEL_POLICY="$HOME/.config/ollama-tunnel/policy.yml"   # default; written by `ollama-tunnel new-password`

# Copy to ~/.config/rc-loop.env and edit. rc-loop sources it at startup.
RC_REPO="$HOME/code/my-project"   # the git repo the server runs in (a repo, not $HOME)
RC_NAME="My project on Studio"    # title shown at claude.ai/code and in the Claude app
RC_SPAWN="worktree"               # worktree | same-dir | session
RC_RESTART_DELAY=30               # seconds to wait before restarting after an exit
RC_CHROME=""                      # 1 = give sessions Claude in Chrome (--chrome), 0 = --no-chrome, empty = no flag
# RC_DEBUG_DIR="$HOME/Library/Logs/rc-loop"   # the server's debug log (--debug-file), one file per start; "" = off
